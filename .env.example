# 1. Get a free key at https://aistudio.google.com/apikey
#    Without it, VANTA runs the clearly labelled deterministic demo planner.
GEMINI_API_KEY=

# 2. (Optional) Which Gemini model to use. The active model is shown in Settings.
GEMINI_MODEL=gemini-flash-latest

# 3. (Optional) Testnet signing wallet (Base Sepolia only).
#    Leave empty to create a local .agent-wallet.json, or set a TEST wallet key.
#    Never use a wallet holding real funds.
WALLET_PRIVATE_KEY=

# 4. Facilitator wallet: verifies EIP-3009 signatures and submits testnet USDC
#    settlement. Required only for the paid APIs. Holds testnet gas ETH.
FACILITATOR_PRIVATE_KEY=
FACILITATOR_ADDRESS=

# 5. (Optional) Hard per-run spending ceiling in testnet USDC (default 0.25, max 5).
MAX_RUN_SPEND_USDC=0.25

# 6. (Optional) Comma-separated host suffixes the research crawler may read.
#    Defaults to Wikipedia, Hacker News, GitHub and MDN.
CRAWL_ALLOWED_HOSTS=
